# Database connection string (Postgres only)
DATABASE_URL=postgresql://retailpulse:retailpulse@localhost:5432/retailpulse

# Secret used to sign JWT access/refresh tokens - use a long random value in production
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=20

# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Runtime environment name (development | staging | production)
ENVIRONMENT=development

# Port the API server listens on
PORT=4000

# Base URL of the frontend app; used to build the link inside the password reset email
FRONTEND_URL=http://localhost:5173

# How long a password reset token remains valid, in minutes
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP settings for outgoing email (password reset). Leave blank to disable sending -
# the API will still respond successfully but will skip the email and log a warning instead.
# Example for Gmail: host=smtp.gmail.com, port=587, username=your address, password=an App Password
# (not your normal Gmail password - generate one at https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@retailpulse.app
SMTP_FROM_NAME=RetailPulse
